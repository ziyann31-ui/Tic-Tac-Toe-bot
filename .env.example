# Copy this to .env and fill in your values

# Get this from @BotFather
BOT_TOKEN=your_bot_token_here

# Your Telegram User ID (get from @userinfobot)
OWNER_ID=6779799030

# Your Render deployed URL (update after first deploy)
APP_URL=https://your-service.onrender.com

# MongoDB Atlas Connection String
# Get this from MongoDB Atlas Dashboard → Connect → Drivers → Python
# Format: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here